# Raw dictionary sources: run `npm run data:fetch`
data/sources/*
!data/sources/SOURCE.json

# Generated app data is committed under public/data so deployments work
# without re-downloading the source dictionaries.
#
# The pinyin suggestion dictionaries are copied from the npm package by
# scripts/copy-pinyin-dict.mjs during dev/build.
public/data/pinyin/

